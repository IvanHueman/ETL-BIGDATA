# Copia este archivo como .env y ajusta lo que necesites.

# Base de datos. Sin esta línea se usa SQLite en data/dpdf.db (no hay que instalar nada).
# Para Postgres + TimescaleDB (docker compose up -d):
# DATABASE_URL=postgresql+psycopg://dpdf:dpdf@localhost:5432/dpdf

# Tipo de cambio USD->MXN (Alibaba publica en dólares).
# Token gratuito de Banxico: https://www.banxico.org.mx/SieAPIRest/
BANXICO_TOKEN=
# Se usa solo si no hay token o Banxico no responde. ACTUALÍZALO antes de capturar.
TIPO_CAMBIO_USD_RESPALDO=18.50
